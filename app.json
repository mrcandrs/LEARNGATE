{
  "expo": {
    "name": "LEARNGATE",
    "slug": "learngate",
    "scheme": "learngate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#C5E84D"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C5E84D"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.pipsjacob.learngate"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LEARNGATE to use your camera for physical exercise activities."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow LEARNGATE to share child location for parent safety monitoring."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow LEARNGATE to use your camera so you can verify completed chores with a photo."
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff",
          "defaultChannel": "tasks"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "ndkVersion": "26.1.10909125"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c3b18f1d-485e-4efb-aae8-a22fac7245df"
      }
    },
    "owner": "mrcandrs1"
  }
}
